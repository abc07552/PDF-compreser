{
  "name": "pdf-mb-reducer-ai-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:assets",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run prepare:assets && node scripts/test.mjs",
    "android:sync": "npm run build && node scripts/sync-android.mjs",
    "package:source": "npm run android:sync && node scripts/package-source.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json *.html",
    "check": "tsc --noEmit && prettier --check src scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "1.58.2",
    "@sparticuz/chromium": "143.0.4",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
